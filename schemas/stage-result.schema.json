{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-agent-lab.local/schemas/stage-result.schema.json",
  "title": "Pipeline Stage Result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "stage", "status", "metrics", "artifacts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["intake", "normalize", "calculate", "reconcile", "report"] },
    "status": { "enum": ["pending", "running", "success", "warning", "failed", "rejected"] },
    "message": { "type": ["string", "null"] },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "started_at": { "type": ["string", "null"] },
    "ended_at": { "type": ["string", "null"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}

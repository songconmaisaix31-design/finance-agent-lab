{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-agent-lab.local/schemas/run-result.schema.json",
  "title": "Run Result Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "city",
    "pipeline",
    "storage",
    "rules",
    "status",
    "period",
    "config",
    "metrics",
    "validation",
    "reconciliation",
    "capabilities",
    "artifacts",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version"],
      "properties": {
        "profile_id": { "type": "string" },
        "version": { "type": "integer" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_set_id", "status"],
      "properties": {
        "rule_set_id": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "status": { "enum": ["success", "blocked", "failed", "planned"] },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "approval_status"],
      "properties": {
        "version": { "type": "integer" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "approval_status": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_income_types", "unknown_delivery_types", "reconciliation_errors", "warnings"],
      "properties": {
        "unknown_income_types": { "type": "integer", "minimum": 0 },
        "unknown_delivery_types": { "type": "integer", "minimum": 0 },
        "unknown_crowd_cost_rows": { "type": "integer", "minimum": 0 },
        "rejected_crowd_cost_rows": { "type": "integer", "minimum": 0 },
        "reconciliation_errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crowd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "currency",
            "total",
            "buckets",
            "source_rows",
            "accepted_rows",
            "unknown_rows",
            "rejected_rows",
            "rule_approval_status"
          ],
          "properties": {
            "status": { "enum": ["complete", "blocked", "unavailable"] },
            "currency": { "const": "CNY" },
            "total": { "type": "string" },
            "buckets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "amount", "completed_orders", "approval_status"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "amount": { "type": "string" },
                  "completed_orders": { "type": "string" },
                  "approval_status": { "type": "string" }
                }
              }
            },
            "source_rows": { "type": "integer", "minimum": 0 },
            "accepted_rows": { "type": "integer", "minimum": 0 },
            "unknown_rows": { "type": "integer", "minimum": 0 },
            "rejected_rows": { "type": "integer", "minimum": 0 },
            "rule_approval_status": { "type": "string" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "engine_version", "status", "summary", "checks", "warnings", "errors", "created_at"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "engine_version": { "type": "string" },
        "status": { "enum": ["passed", "failed", "blocked", "partial"] },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "blocked", "not_applicable", "not_implemented", "total"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "not_applicable": { "type": "integer", "minimum": 0 },
            "not_implemented": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "category",
              "status",
              "severity",
              "description",
              "expected",
              "actual",
              "difference",
              "tolerance",
              "currency",
              "source_components",
              "approval_status",
              "rule_source",
              "error_code",
              "safe_message"
            ],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "category": { "enum": ["structural", "arithmetic", "cross_table", "contract"] },
              "status": { "enum": ["pass", "fail", "blocked", "not_applicable", "not_implemented"] },
              "severity": { "enum": ["info", "warning", "error", "blocking"] },
              "description": { "type": "string" },
              "expected": { "type": ["string", "null"] },
              "actual": { "type": ["string", "null"] },
              "difference": { "type": ["string", "null"] },
              "tolerance": { "type": ["string", "null"] },
              "currency": { "type": ["string", "null"] },
              "source_components": {
                "type": "array",
                "items": { "type": "string" }
              },
              "approval_status": { "enum": ["technical", "unverified", "approved"] },
              "rule_source": { "enum": ["technical_invariant", "existing_code", "city_config", "documented_business_rule", "unknown"] },
              "error_code": { "type": ["string", "null"] },
              "safe_message": { "type": ["string", "null"] }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/reconciliation_error" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/reconciliation_error" }
        },
        "created_at": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "media_type", "sha256", "size_bytes"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "created_at": { "type": "string" }
  },
  "$defs": {
    "reconciliation_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "check_id", "stage", "safe_message", "expected", "actual", "difference"],
      "properties": {
        "error_code": { "type": "string" },
        "check_id": { "type": "string" },
        "stage": { "type": "string" },
        "safe_message": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "difference": { "type": "string" }
      }
    }
  }
}
